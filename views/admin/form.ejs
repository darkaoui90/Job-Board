<%- include('../partials/header', { title: offer.id ? 'Modifier une offre' : 'Nouvelle offre', page: page }) %>

<div class="page-heading">
  <div>
    <span class="sub">Administration</span>
    <h1><%= offer.id ? 'Modifier une offre' : 'Deposer une offre' %></h1>
  </div>
  <a href="/admin/offres" class="btn btn-outline">&larr; Retour</a>
</div>

<% if (error) { %><p class="alert alert-error"><%= error %></p><% } %>

<form class="form-section-card" action="<%= offer.id ? '/admin/offres/' + offer.id + '/modifier' : '/admin/offres' %>" method="post">
  <div class="form-grid">
    <div class="form-group full-width">
      <label class="form-label" for="titre">Titre *</label>
      <input class="input-control" id="titre" name="titre" value="<%= offer.titre %>" required>
    </div>
    <div class="form-group">
      <label class="form-label" for="entreprise_id">Entreprise *</label>
      <select class="input-control" id="entreprise_id" name="entreprise_id" required>
        <option value="">Choisir...</option>
        <% companies.forEach(function (company) { %>
          <option value="<%= company.id %>" <%= Number(offer.entreprise_id) === company.id ? 'selected' : '' %>><%= company.nom %></option>
        <% }); %>
      </select>
    </div>
    <div class="form-group">
      <label class="form-label" for="ville">Ville *</label>
      <input class="input-control" id="ville" name="ville" value="<%= offer.ville %>" required>
    </div>
    <div class="form-group">
      <label class="form-label" for="type_contrat">Contrat *</label>
      <select class="input-control" id="type_contrat" name="type_contrat" required>
        <option value="Stage" <%= offer.type_contrat === 'Stage' ? 'selected' : '' %>>Stage</option>
        <option value="Alternance" <%= offer.type_contrat === 'Alternance' ? 'selected' : '' %>>Alternance</option>
      </select>
    </div>
    <div class="form-group">
      <label class="form-label" for="date_publication">Date de publication *</label>
      <input class="input-control" type="date" id="date_publication" name="date_publication" value="<%= new Date(offer.date_publication).toISOString().slice(0, 10) %>" required>
    </div>
    <div class="form-group full-width">
      <label class="form-label" for="description_courte">Resume *</label>
      <textarea class="input-control" id="description_courte" name="description_courte" required><%= offer.description_courte %></textarea>
    </div>
    <div class="form-group full-width">
      <label class="form-label" for="description_longue">Description complete</label>
      <textarea class="input-control" id="description_longue" name="description_longue"><%= offer.description_longue || '' %></textarea>
    </div>
    <fieldset class="form-group full-width">
      <legend class="form-label">Technologies</legend>
      <div class="selectable-chips">
        <% technologies.forEach(function (technology) { %>
          <input class="chip-checkbox-hidden" type="checkbox" id="tech-<%= technology.id %>" name="technologies" value="<%= technology.id %>" <%= offer.technologyIds.includes(technology.id) ? 'checked' : '' %>>
          <label class="chip-label" for="tech-<%= technology.id %>"><%= technology.nom %></label>
        <% }); %>
      </div>
    </fieldset>
  </div>
  <div class="form-actions">
    <a href="/admin/offres" class="btn btn-outline">Annuler</a>
    <button type="submit" class="btn btn-primary"><%= offer.id ? 'Enregistrer' : "Creer l'offre" %></button>
  </div>
</form>

<%- include('../partials/footer') %>


